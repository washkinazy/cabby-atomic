        {
          "type": "insecureAcceptAnything"
        }
      ],
      "ghcr.io/washkinazy/cabby-atomic": [
        {
          "type": "sigstoreSigned",
          "keyPath": "/etc/pki/containers/cabby-atomic.pub",
